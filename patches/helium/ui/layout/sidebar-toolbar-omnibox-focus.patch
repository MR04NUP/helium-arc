+bool ChromeOmniboxClient::ShowsSuggestionsOnFocusForPages() const {
+  // An address bar hosted in the vertical tab strip is too narrow to read an
+  // address in, so it opens its results as soon as it is focused.
+  const auto* const layout_state_controller =
+      browser_ ? HeliumLayoutStateController::From(browser_) : nullptr;
+  return layout_state_controller &&
+         layout_state_controller->IsSidebarToolbarEnabled();
+}
