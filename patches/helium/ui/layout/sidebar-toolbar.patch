+               location_bar_height);
+  const int width = bounds.width().is_bounded() ? bounds.width().value()
+                                                : kSidebarToolbarDefaultWidth;
+  const int actions_y = margin.top();
+  const int location_y = actions_y + row_height + kSidebarToolbarRowGap;
+
+  views::ProposedLayout layout;
+  layout.host_size =
+      gfx::Size(width, location_y + row_height + margin.bottom());
+
+  const auto can_show = [this](const views::View* view) {
+    return view && layout_manager_->CanBeVisible(view);
+  };
+  const auto add = [&layout](views::View* view, const gfx::Rect& rect,
+                             bool visible) {
+    layout.child_layouts.push_back(
+        {view, visible, rect, views::SizeBounds(rect.size())});
+  };
+  const auto centered = [row_height](int x, int row_y, const gfx::Size& size) {
+    return gfx::Rect(x, row_y + (row_height - size.height()) / 2, size.width(),
+                     size.height());
+  };
+
+  // Second row: the address bar, which slides aside to uncover the navigation
+  // and menu buttons while they are revealed.
+  const double reveal = sidebar_controls_animation_.GetCurrentValue();
+  const bool controls_revealed = reveal > 0.0;
+
+  int navigation_width = 0;
+  for (ToolbarButton* button : {back_.get(), forward_.get()}) {
+    if (!button) {
+      continue;
+    }
+    const bool visible = controls_revealed && can_show(button) &&
+                         (button != forward_ || forward_->GetEnabled());
+    gfx::Rect rect;
+    if (visible) {
+      const gfx::Size size = button->GetPreferredSize();
+      rect = centered(margin.left() + navigation_width, location_y, size);
+      navigation_width += size.width() + spacing;
+    }
+    add(button, rect, visible);
+  }
+
+  int menu_width = 0;
+  if (app_menu_button_) {
+    const bool visible = controls_revealed && can_show(app_menu_button_);
+    gfx::Rect rect;
+    if (visible) {
+      const gfx::Size size = app_menu_button_->GetPreferredSize();
+      rect = centered(width - margin.right() - size.width(), location_y, size);
+      menu_width = size.width() + spacing;
+    }
+    add(app_menu_button_, rect, visible);
+  }
+
+  const int location_x =
+      margin.left() + base::ClampRound(navigation_width * reveal);
+  const int location_right =
+      width - margin.right() - base::ClampRound(menu_width * reveal);
+  add(location_bar_view_,
+      gfx::Rect(location_x, location_y + (row_height - location_bar_height) / 2,
+                std::max(0, location_right - location_x), location_bar_height),
+      can_show(location_bar_view_));
+
+  // First row: the sidebar toggle beside the caption buttons, with the pinned
+  // actions filling in from the trailing edge.
+  int leading = margin.left() + sidebar_leading_caption_inset_;
+  int trailing = width - margin.right() - sidebar_trailing_caption_inset_;
+
+  if (vertical_tabs_collapse_button_) {
+    const bool visible = can_show(vertical_tabs_collapse_button_);
+    gfx::Rect rect;
+    if (visible) {
+      const gfx::Size size = vertical_tabs_collapse_button_->GetPreferredSize();
+      rect = centered(leading, actions_y, size);
+      leading = rect.right() + spacing;
+    }
+    add(vertical_tabs_collapse_button_, rect, visible);
+  }
+
+  for (views::View* child : base::Reversed(children())) {
+    if (child->GetProperty(views::kViewIgnoredByLayoutKey) ||
+        layout.GetLayoutFor(child)) {
+      continue;
+    }
+
+    bool visible = IsSidebarActionView(child) && can_show(child);
+    gfx::Rect rect;
+    // The containers size themselves to the room they are offered, so offer
+    // all that is left rather than what they currently take up.
+    const views::SizeBounds offered(std::max(0, trailing - leading),
+                                    row_height);
+    if (visible) {
+      gfx::Size size = GetSidebarActionViewSize(child, offered);
+      size.SetToMin(gfx::Size(offered.width().value(), row_height));
+      if (size.width() < child->GetMinimumSize().width()) {
+        visible = false;
+      } else {
+        rect = centered(trailing - size.width(), actions_y, size);
+        if (!rect.IsEmpty()) {
+          trailing = rect.x() - spacing;
+        }
+      }
+    }
+    layout.child_layouts.push_back({child, visible, rect, offered});
+  }
+
+  return layout;
+}
+
+gfx::Size ToolbarView::GetSidebarActionViewSize(
+    const views::View* child,
+    const views::SizeBounds& bounds) const {
+  // The action containers animate their size. Asking for the size they are
+  // heading towards keeps a container that was laid out while empty or hidden
+  // from being stuck at that size.
+  if (child == extensions_container_) {
+    return extensions_container_->GetAnimatingLayoutManager()
+        ->GetDefaultFlexRule()
+        .Run(child, bounds);
+  }
+  if (child == pinned_toolbar_actions_container_) {
+    return pinned_toolbar_actions_container_->GetAnimatingLayoutManager()
+        ->GetDefaultFlexRule()
+        .Run(child, bounds);
+  }
+  return child->GetPreferredSize(bounds);
+}
+
+bool ToolbarView::IsSidebarActionView(const views::View* child) const {
+  // Reloading, the profile menu and everything else left out here is reached
+  // through the menu beside the address bar.
+  if (child == reload_ || child == home_ || child == overflow_button_ ||
+      child == dynamic_new_tab_button_ || child == toolbar_webview_ ||
+      child == tab_strip_region_view_ || child == toolbar_divider_ ||
+      child == glic_button_divider_) {
+    return false;
+  }
+
+  // The avatar is the only indication of an incognito or guest window.
+  if (child == avatar_) {
+    return !browser_->GetProfile()->IsRegularProfile();
+  }
+
+  return true;
+}
+
+void ToolbarView::UpdateSidebarControlsReveal() {
+  if (!sidebar_mode_) {
+    return;
+  }
+
+  const auto in_use = [](const ToolbarButton* button) {
+    return button && (button->HasFocus() || button->IsMenuShowing());
+  };
+  const bool reveal =
+      IsCursorInSidebarLocationRow() || in_use(back_) || in_use(forward_) ||
+      (app_menu_button_ &&
+       (app_menu_button_->HasFocus() || app_menu_button_->IsMenuShowing()));
+  if (reveal == sidebar_controls_animation_.IsShowing()) {
+    return;
+  }
+
+  if (reveal) {
+    sidebar_controls_animation_.Show();
+  } else {
+    sidebar_controls_animation_.Hide();
+  }
+}
+
+bool ToolbarView::IsCursorInSidebarLocationRow() const {
+  if (!GetWidget() || !location_bar_view_) {
+    return false;
+  }
+
+  gfx::Point cursor = display::Screen::Get()->GetCursorScreenPoint();
+  views::View::ConvertPointFromScreen(this, &cursor);
+  const int row_top = location_bar_view_->y() - kSidebarToolbarRowGap / 2;
+  return gfx::Rect(0, row_top, width(), height() - row_top).Contains(cursor);
+}
