+    static_cast<CustomCornersBackground*>(background())
+        ->SetVisible(!sidebar_mode_);
+  }
+
+  // Only pinned extensions are shown in the sidebar.
+  if (extensions_container_ && extensions_container_->GetExtensionsButton()) {
+    extensions_container_->GetExtensionsButton()->SetVisible(!sidebar_mode_);
+  }
+
+  UpdateToolbarLayout();
+  PreferredSizeChanged();
+  SchedulePaint();
