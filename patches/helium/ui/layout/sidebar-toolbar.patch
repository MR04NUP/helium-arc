+void ToolbarView::SetSidebarMode(bool sidebar_mode) {
+  if (sidebar_mode_ == sidebar_mode || display_mode_ != DisplayMode::kNormal) {
+    return;
+  }
+
+  sidebar_mode_ = sidebar_mode;
+  if (sidebar_mode_) {
+    sidebar_hover_handler_ = std::make_unique<SidebarHoverHandler>(this);
+  } else {
+    sidebar_hover_handler_.reset();
+    sidebar_controls_animation_.Reset(0);
