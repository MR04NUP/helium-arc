+
+void ToolbarView::ShowSidebarPageMenu() {
+  if (!sidebar_mode_ || !app_menu_button_ ||
+      (sidebar_page_menu_runner_ && sidebar_page_menu_runner_->IsRunning())) {
+    return;
+  }
+
+  // The commands run once the menu has closed, so they can open another one.
+  const auto post_to_self = [this](void (ToolbarView::*method)()) {
+    return base::BindRepeating(
+        [](base::WeakPtr<ToolbarView> toolbar, void (ToolbarView::*method)()) {
+          base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+              FROM_HERE, base::BindOnce(method, toolbar));
+        },
+        weak_ptr_factory_.GetWeakPtr(), method);
+  };
+
+  sidebar_page_menu_runner_.reset();
+  sidebar_page_menu_model_ = std::make_unique<SidebarPageMenuModel>(
+      browser_, extensions_container_ != nullptr,
+      post_to_self(&ToolbarView::ShowExtensionsMenuFromSidebar),
+      post_to_self(&ToolbarView::ShowAppMenuFromSidebar));
+  sidebar_page_menu_adapter_ = std::make_unique<views::MenuModelAdapter>(
+      sidebar_page_menu_model_.get(),
+      base::BindRepeating(&ToolbarView::OnSidebarPageMenuClosed,
+                          weak_ptr_factory_.GetWeakPtr()));
+  sidebar_page_menu_runner_ = std::make_unique<views::MenuRunner>(
+      sidebar_page_menu_adapter_->CreateMenu(),
+      views::MenuRunner::HAS_MNEMONICS);
+
+  sidebar_page_menu_active_ = true;
+  UpdateSidebarControlsReveal();
+  sidebar_page_menu_runner_->RunMenuAt(
+      GetWidget(), nullptr, app_menu_button_->GetAnchorBoundsInScreen(),
+      IsVerticalTabsRightAligned() ? views::MenuAnchorPosition::kTopRight
+                                   : views::MenuAnchorPosition::kTopLeft,
+      ui::mojom::MenuSourceType::kNone);
+}
+
+void ToolbarView::OnSidebarPageMenuClosed() {
+  sidebar_page_menu_active_ = false;
+  // A command that opens another menu runs after this, and needs the button
+  // it anchors to.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ToolbarView::UpdateSidebarControlsReveal,
+                                weak_ptr_factory_.GetWeakPtr()));
+}
+
+void ToolbarView::ShowExtensionsMenuFromSidebar() {
+  if (extensions_container_ && extensions_container_->GetExtensionsButton()) {
+    extensions_container_->GetExtensionsButton()->ToggleExtensionsMenu();
+  }
+}
+
+void ToolbarView::ShowAppMenuFromSidebar() {
+  if (app_menu_button_) {
+    app_menu_button_->ShowMenu(views::MenuRunner::NO_FLAGS);
+    UpdateSidebarControlsReveal();
+  }
+}
