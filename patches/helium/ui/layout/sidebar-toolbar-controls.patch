+// The short menu shown by the three-dots button beside the address bar in
+// sidebar mode. It holds what the hidden toolbar buttons did, and leads to the
+// app menu for everything else.
+class SidebarPageMenuModel : public ui::SimpleMenuModel,
+                             public ui::SimpleMenuModel::Delegate {
+ public:
+  // Entries without a browser command. Browser commands use their IDC_ values,
+  // which are far larger.
+  enum Command {
+    kShowExtensionsMenu = 1,
+    kShowAppMenu,
+  };
+
+  SidebarPageMenuModel(BrowserWindowInterface* browser,
+                       bool has_extensions,
+                       base::RepeatingClosure show_extensions_menu,
+                       base::RepeatingClosure show_app_menu)
+      : ui::SimpleMenuModel(this),
+        browser_(browser),
+        show_extensions_menu_(std::move(show_extensions_menu)),
+        show_app_menu_(std::move(show_app_menu)) {
+    AddItemWithStringId(IDC_RELOAD, IDS_APP_MENU_RELOAD);
+    AddItemWithStringId(IDC_COPY_URL, IDS_COPY_URL);
+    AddSeparator(ui::NORMAL_SEPARATOR);
+    if (has_extensions) {
+      AddItemWithStringId(kShowExtensionsMenu, IDS_EXTENSIONS_SUBMENU);
+    }
+    AddItemWithStringId(IDC_SHOW_AVATAR_MENU, IDS_PROFILES_MENU_NAME);
+    AddSeparator(ui::NORMAL_SEPARATOR);
+    AddItemWithStringId(kShowAppMenu, IDS_SIDEBAR_PAGE_MENU_MORE);
+  }
+
+  ~SidebarPageMenuModel() override = default;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdEnabled(int command_id) const override {
+    return command_id == kShowExtensionsMenu || command_id == kShowAppMenu ||
+           chrome::IsCommandEnabled(browser_, command_id);
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    switch (command_id) {
+      case kShowExtensionsMenu:
+        show_extensions_menu_.Run();
+        break;
+      case kShowAppMenu:
+        show_app_menu_.Run();
+        break;
+      default:
+        chrome::ExecuteCommand(browser_, command_id);
+        break;
+    }
+  }
+
+ private:
+  const raw_ptr<BrowserWindowInterface> browser_;
+  base::RepeatingClosure show_extensions_menu_;
+  base::RepeatingClosure show_app_menu_;
+};
