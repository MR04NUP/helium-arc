+void BrowserView::UpdateCaptionButtonsForFullscreen() {
+#if BUILDFLAG(IS_MAC)
+  auto* const frame_view = GetFrameView();
+  if (!frame_view) {
+    return;
+  }
+
+  // A fullscreen window has no titlebar to keep the caption buttons in, so
+  // those in a toolbar hosted in the vertical tab strip stay out of the way
+  // until the cursor reaches the top of the window.
+  if (!IsSidebarToolbarMode() || !IsFullscreen() || !IsToolbarVisible()) {
+    if (fullscreen_caption_buttons_hidden_) {
+      fullscreen_caption_buttons_hidden_ = false;
+      fullscreen_caption_buttons_animation_.Reset(0);
+      frame_view->SetCaptionButtonsOpacity(GetTopChromeRevealRatio());
+      UpdateCaptionButtonsForSideChrome();
+    }
+    return;
+  }
+  fullscreen_caption_buttons_hidden_ = true;
+
+  gfx::Point cursor;
+  const bool reveal =
+      GetCursorLocationInBrowserView(&cursor) &&
+      GetLocalBounds().Contains(cursor) &&
+      cursor.y() < GetSidebarToolbarTopOffset() +
+                       toolbar_->GetSidebarCaptionRowHeight();
+  if (reveal != fullscreen_caption_buttons_animation_.IsShowing()) {
+    if (reveal) {
+      fullscreen_caption_buttons_animation_.Show();
+    } else {
+      fullscreen_caption_buttons_animation_.Hide();
+    }
+  }
+  frame_view->SetCaptionButtonsOpacity(
+      fullscreen_caption_buttons_animation_.GetCurrentValue());
+#endif  // BUILDFLAG(IS_MAC)
+}
