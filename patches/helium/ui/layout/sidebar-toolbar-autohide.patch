+
+void BrowserView::UpdateSidebarToolbarHiddenState() {
+  const bool hidden = IsSidebarToolbarHidden();
+  if (sidebar_toolbar_hidden_ == hidden) {
+    return;
+  }
+  sidebar_toolbar_hidden_ = hidden;
+
+  if (hidden) {
+    // Focus inside the tab strip would keep it revealed.
+    views::View* const focused_view =
+        GetFocusManager() ? GetFocusManager()->GetFocusedView() : nullptr;
+    if (focused_view && vertical_tab_strip_region_view_ &&
+        vertical_tab_strip_region_view_->Contains(focused_view)) {
+      GetActiveContentsWebView()->RequestFocus();
+    }
+
+    // Hide right away, even when the cursor is still over the button that was
+    // just pressed. The tab strip then stays away until the cursor has left.
+    gfx::Point cursor = display::Screen::Get()->GetCursorScreenPoint();
+    views::View::ConvertPointFromScreen(this, &cursor);
+    side_reveal_suppressed_ =
+        IsPointInZenSideTrigger(cursor) || IsPointInZenSideChromeBounds(cursor);
+    zen_cursor_exit_timer_.Stop();
+    zen_side_chrome_animation_.Hide();
+  } else {
+    side_reveal_suppressed_ = false;
+    if (!zen_mode_enabled_ || IsZenModeSideChromePinned()) {
+      zen_side_chrome_animation_.Reset(1);
+    }
+  }
+
+  UpdateCaptionButtonsForSideChrome();
+  if (multi_contents_view_) {
+    multi_contents_view_->MaybeUpdateContentsBorderAndOverlay();
+  }
+  InvalidateLayout();
+}
+
+void BrowserView::RevealSideChromeImmediately() {
+  side_reveal_suppressed_ = false;
+  zen_cursor_exit_timer_.Stop();
+  zen_side_chrome_animation_.Reset(1);
+  UpdateCaptionButtonsForSideChrome();
+  InvalidateLayout();
+  DeprecatedLayoutImmediately();
+}
+
+void BrowserView::UpdateCaptionButtonsForSideChrome() {
+#if BUILDFLAG(IS_MAC)
+  // The caption buttons sit over a leading tab strip that hosts the toolbar,
+  // so they come and go with it. Zen mode fades them with the top chrome
+  // instead.
+  if (zen_mode_enabled_) {
+    return;
