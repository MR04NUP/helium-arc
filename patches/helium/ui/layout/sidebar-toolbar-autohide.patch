+  if (auto* frame_view = GetFrameView()) {
+    frame_view->SetCaptionButtonsOpacity(
+        sidebar_toolbar_hidden_ && !IsVerticalTabStripRightAligned()
+            ? GetSideChromeRevealRatio()
+            : 1.0f);
+  }
+#endif  // BUILDFLAG(IS_MAC)
+}
